# Public
NEXT_PUBLIC_APP_URL=

# Clerk (accounts). Add both keys. Production on Cloudflare also needs the proxy URL and authorized parties.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
# Absolute https URL only, e.g. https://diras.app/__clerk — never a relative /__clerk
NEXT_PUBLIC_CLERK_PROXY_URL=
# Extra origins allowed to present a Clerk session (comma-separated). NEXT_PUBLIC_APP_URL is included automatically.
CLERK_AUTHORIZED_PARTIES=
# Optional. Networkless JWT verification on Workers (Clerk Dashboard → API keys → JWKS public key).
CLERK_JWT_KEY=

# Stripe (Malaysia, UAE, Saudi, UK, US and default)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Paystack (Nigeria / West Africa). Plan codes are optional — monthly/annual plans are created if empty.
PAYSTACK_SECRET_KEY=
PAYSTACK_PLAN_MONTHLY=
PAYSTACK_PLAN_ANNUAL=

# Clerk webhooks (new users / sign-ins). Dashboard → Webhooks → /api/auth/webhook
CLERK_WEBHOOK_SIGNING_SECRET=

# Signs the Diras Plus entitlement cookie. Falls back to a processor secret if unset.
BILLING_SIGNING_SECRET=

# Diras Plus confirmation email after a successful grant (not the Paystack/Stripe receipt).
RESEND_API_KEY=
EMAIL_FROM=

# Neon (user rows). Optional until we host synced sessions / entitlements.
DATABASE_URL=

# R2 public origin for hosted audio (custom domain on the bucket). Optional until we host files.
R2_PUBLIC_BASE_URL=
