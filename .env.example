# Public
NEXT_PUBLIC_APP_URL=

# Accounts. Neon holds users and sessions. AUTH_SECRET falls back to BILLING_SIGNING_SECRET.
# Tables are created automatically on first query — you do not paste db/schema.sql.
DATABASE_URL=
AUTH_SECRET=

# Cloudflare Turnstile (bot check on the password form). Dummy keys for local: site 1x00000000000000000000AA, secret 1x0000000000000000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Google sign-in (optional). Redirect URI is {APP_URL}/api/auth/google/callback
# OAuth consent screen App name in Google Cloud must be Diras (users see that, not Cloudflare or Neon).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Stripe (Malaysia, UAE, Saudi, UK, US and default)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Paystack (Nigeria / West Africa). Plan codes are optional — monthly/annual plans are created if empty.
PAYSTACK_SECRET_KEY=
PAYSTACK_PLAN_MONTHLY=
PAYSTACK_PLAN_ANNUAL=

# Signs the Diras Plus entitlement cookie. Falls back to a processor secret if unset.
BILLING_SIGNING_SECRET=

# Diras Plus confirmation email after a successful grant (not the Paystack/Stripe receipt). Also sends sign-in codes.
# Primary: Resend (https://resend.com). Falls back to MailChannels if Resend fails or is unset.
RESEND_API_KEY=
EMAIL_FROM=

# MailChannels fallback (free for Cloudflare Workers, no API key needed).
# Generate a 1024-bit RSA keypair, publish the public key in DNS as
# <selector>._domainkey.<domain> TXT v=DKIM1;...;p=<base64-public-key>
# and convert the private key to PKCS#8 with:
#   openssl pkcs8 -topk8 -in private.pem -out private-pkcs8.pem -nocrypt
# Set all three to enable MailChannels. Leave blank to disable.
MAILCHANNELS_DKIM_PRIVATE_KEY=
MAILCHANNELS_DKIM_SELECTOR=mailchannels
MAILCHANNELS_DKIM_DOMAIN=diras.app

# R2 public origin for hosted audio (custom domain on the bucket). Optional until we host files.
R2_PUBLIC_BASE_URL=
