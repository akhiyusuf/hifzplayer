{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "diras-preview",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-10-11",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "vars": {
    // Same public site key as production. Secret: wrangler secret put TURNSTILE_SECRET_KEY
    // against this preview Worker if you deploy it. Never commit the secret.
    "NEXT_PUBLIC_TURNSTILE_SITE_KEY": "0x4AAAAAAE9ruY8EYQqAdKA0"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "diras-preview"
    }
  ]
}
